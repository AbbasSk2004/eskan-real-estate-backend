# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# API Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001/api
WS_URL=ws://localhost:3001
# Frontend URLs (Web + Mobile)
FRONTEND_URL=["https://your-web-app.example.com", "exp://localhost:8081"]

# On-demand ISR revalidation (backend -> Next.js web app)
# WEB_APP_URL is the single Next.js origin to notify (NOT the FRONTEND_URL CORS
# list). REVALIDATION_SECRET must match the web app's REVALIDATION_SECRET.
# Leave either unset to disable revalidation.
WEB_APP_URL=http://localhost:3000
REVALIDATION_SECRET=change_me_to_match_the_web_app

# MongoDB Configuration
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=real_estate_db

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_MAP_SEARCH=true
ENABLE_SOCIAL_SHARING=true
ENABLE_LAZY_LOADING=true
ENABLE_IMAGE_OPTIMIZATION=true
ENABLE_SEARCH_SUGGESTIONS=true
ENABLE_SAVED_SEARCHES=true
DEBUG_AUTH=false

# DeepSeek AI (write-time listing enrichment)
# Used ONLY when a property is created or its text is edited — never on a read
# request. The deterministic ranker keeps working with these unset; listings
# simply carry no aiTags/aiSummary, and recommendation quality is slightly lower.
# NEVER expose this key to the frontend (no NEXT_PUBLIC_* var).
ENABLE_AI_ENRICHMENT=false
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Hard ceiling per call. The SDK's own retries are disabled, so this is the
# real worst case, not a per-attempt budget.
AI_TIMEOUT_MS=8000

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_FILES_COUNT=10

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Email sending (Brevo)
# EMAIL_FROM must be a sender authenticated in Brevo (Senders & IPs > Domain
# authentication). Free-provider addresses (gmail, yahoo, proton.me, ...)
# cannot be authenticated: Brevo accepts the send but recipients will
# spam-filter or reject it.
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=Eskan Real Estate <no-reply@your-authenticated-domain.com>
# When true, OTP codes are echoed in API responses and printed to the server
# log so register/reset flows work without a deliverable mail provider.
# Default: enabled automatically when NODE_ENV != production.
EMAIL_DEV_MODE=false
EMAIL_VERIFICATION_EXPIRY_MINUTES=15

